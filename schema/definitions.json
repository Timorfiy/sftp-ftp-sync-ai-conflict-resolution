{
  "rootOption": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Optional display name for this connection."
      },
      "context": {
        "type": "string",
        "description": "Local path relative to the workspace root. Omission uses the workspace root."
      },
      "watcher": {
        "type": "object",
        "description": "Optional local filesystem watcher. Omission disables watcher automation.",
        "default": {
          "files": false,
          "autoUpload": false,
          "autoDelete": false,
          "autoRename": false
        },
        "properties": {
          "files": {
            "oneOf": [
              { "type": "string" },
              { "enum": [false, null] }
            ],
            "description": "A glob string, false, or null. A glob is required for watcher automation."
          },
          "autoUpload": {
            "type": "boolean",
            "default": false
          },
          "autoDelete": {
            "type": "boolean",
            "default": false,
            "description": "Delete matching remote paths after local deletion. Destructive."
          },
          "autoRename": {
            "type": "boolean",
            "default": false,
            "description": "Use server-side rename for renames performed through the editor."
          }
        }
      },
      "defaultProfile": {
        "type": "string",
        "description": "Profile selected at startup."
      }
    }
  },
  "option": {
    "type": "object",
    "properties": {
      "remote": {
        "type": "string",
        "description": "Name of a remotefs.remote editor setting used to fill omitted connection fields."
      },
      "uploadOnSave": {
        "type": "boolean",
        "default": false
      },
      "conflictCheck": {
        "type": "boolean",
        "default": false,
        "description": "Block an unsafe overwrite when the remote baseline changed or is unavailable. New generated configurations explicitly set true."
      },
      "useTempFile": {
        "type": "boolean",
        "default": false
      },
      "openSsh": {
        "type": "boolean",
        "default": false,
        "description": "Use OpenSSH atomic rename with useTempFile."
      },
      "downloadOnOpen": {
        "enum": [false, true, "confirm"],
        "default": false
      },
      "concurrency": {
        "type": "integer",
        "minimum": 1,
        "default": 4,
        "description": "Parallel SFTP transfers. FTP is forced to one."
      },
      "syncOption": {
        "type": "object",
        "properties": {
          "delete": {
            "type": "boolean",
            "default": false,
            "description": "Delete destination-only paths. backup.onDelete does not cover sync deletion."
          },
          "skipCreate": {
            "type": "boolean",
            "default": false
          },
          "ignoreExisting": {
            "type": "boolean",
            "default": false
          },
          "update": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "backup": {
        "type": "object",
        "description": "Text/source backups. Overwrite backup failure is fail-open; explicit delete backup is fail-closed when enabled.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "location": {
            "enum": ["remote", "local"],
            "default": "remote"
          },
          "folder": {
            "type": "string",
            "default": ".vscode/sftp-backup"
          },
          "versions": {
            "type": "integer",
            "minimum": 0,
            "default": 100
          },
          "onDelete": {
            "type": "boolean",
            "default": false,
            "description": "Back up explicit/watcher/Git deletion before deleting. Does not cover syncOption.delete."
          }
        },
        "default": {
          "enabled": false,
          "location": "remote",
          "folder": ".vscode/sftp-backup",
          "versions": 100,
          "onDelete": false
        }
      },
      "ignore": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "User ignore patterns. The generated safety list is explicit template data, not the omission default."
      },
      "ignoreFile": {
        "type": "string"
      },
      "remoteExplorer": {
        "type": "object",
        "properties": {
          "filesExclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "order": {
            "type": "number",
            "default": 0
          },
          "enableDragAndDrop": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "remoteTimeOffsetInHours": {
        "type": "number",
        "default": 0
      },
      "keepalive": {
        "type": "integer",
        "minimum": 0,
        "description": "Milliseconds. SFTP omission uses 30000; FTP omission disables keepalive."
      },
      "limitOpenFilesOnRemote": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "number"
          }
        ],
        "description": "SFTP only. Omit/false to disable, true for 222, or a number clamped to at least 127."
      },
      "filePerm": {
        "type": "number"
      },
      "dirPerm": {
        "type": "number"
      },
      "hooks": {
        "type": "object",
        "properties": {
          "preUpload": { "type": "string" },
          "postUpload": { "type": "string" },
          "preDownload": { "type": "string" },
          "postDownload": { "type": "string" },
          "preSync": { "type": "string" },
          "postSync": { "type": "string" }
        },
        "description": "Shell commands run from the workspace. Review untrusted hooks before use."
      }
    }
  },
  "host": {
    "type": "object",
    "properties": {
      "host": {
        "type": "string",
        "minLength": 1
      },
      "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "username": {
        "type": "string"
      },
      "password": {
        "type": ["string", "null"],
        "description": "Prefer null or omission so Secret Storage/prompting is used."
      },
      "remotePath": {
        "type": "string",
        "default": "./"
      },
      "connectTimeout": {
        "type": "integer",
        "minimum": 0,
        "default": 10000
      }
    }
  },
  "sftp": {
    "type": "object",
    "properties": {
      "agent": {
        "type": ["string", "null"]
      },
      "privateKeyPath": {
        "type": ["string", "null"]
      },
      "passphrase": {
        "oneOf": [
          { "type": "string" },
          { "enum": [true] },
          { "type": "null" }
        ]
      },
      "interactiveAuth": {
        "oneOf": [
          { "type": "boolean" },
          {
            "type": "array",
            "items": { "type": "string" }
          }
        ],
        "default": false
      },
      "algorithms": {
        "type": "object"
      },
      "sshConfigPath": {
        "type": "string"
      },
      "sshCustomParams": {
        "type": "string"
      }
    }
  },
  "ftp": {
    "type": "object",
    "properties": {
      "secure": {
        "oneOf": [
          { "type": "boolean" },
          { "enum": ["control", "implicit"] }
        ],
        "default": false,
        "description": "FTPS modes are experimental in version 0.1.0."
      },
      "secureOptions": {
        "type": ["object", "null"]
      },
      "passive": {
        "type": "boolean",
        "description": "Compatibility field accepted by runtime validation."
      },
      "networkInterface": {
        "type": ["string", "null"],
        "minLength": 1,
        "description": "FTP-only named IPv4 adapter. Null or omission uses system routing."
      },
      "ftpKeepAliveInterval": {
        "type": "integer",
        "minimum": 0,
        "description": "FTP NOOP interval. Omission or zero disables it."
      },
      "ftpReconnectAttempts": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      }
    }
  }
}
