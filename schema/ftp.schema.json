{
  "allOf": [
    { "$ref": "definitions.json#/rootOption" },
    { "$ref": "definitions.json#/option" },
    { "$ref": "definitions.json#/host" },
    { "$ref": "definitions.json#/ftp" },
    {
      "type": "object",
      "required": ["host", "username", "protocol"],
      "properties": {
        "protocol": {
          "enum": ["ftp"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 21
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "allOf": [
              { "$ref": "definitions.json#/option" },
              { "$ref": "definitions.json#/host" },
              { "$ref": "definitions.json#/ftp" }
            ]
          }
        }
      }
    }
  ]
}
