{
  "allOf": [
    { "$ref": "definitions.json#/rootOption" },
    { "$ref": "definitions.json#/option" },
    { "$ref": "definitions.json#/host" },
    { "$ref": "definitions.json#/sftp" },
    {
      "type": "object",
      "required": ["host", "username"],
      "properties": {
        "protocol": {
          "enum": ["sftp"],
          "default": "sftp"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 22
        },
        "hop": {
          "oneOf": [
            { "$ref": "#/definitions/hop" },
            {
              "type": "array",
              "items": { "$ref": "#/definitions/hop" }
            }
          ]
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "allOf": [
              { "$ref": "definitions.json#/option" },
              { "$ref": "definitions.json#/host" },
              { "$ref": "definitions.json#/sftp" }
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "hop": {
      "allOf": [
        { "$ref": "definitions.json#/host" },
        { "$ref": "definitions.json#/sftp" }
      ]
    }
  }
}
