        "title": "Upload Changed Files",
        "category": "SFTP",
        "icon": {
          "light": "resources/light/upload.svg",
          "dark": "resources/dark/upload.svg"
        }
      },
      {
        "command": "sftpSyncAI.upload.activeFile",
