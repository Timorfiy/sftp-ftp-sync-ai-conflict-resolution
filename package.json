{
  "name": "sftp-sync-ai",
  "displayName": "SFTP/FTP Sync + AI Conflict Resolution",
  "description": "SFTP/FTP synchronization with AI-assisted conflict resolution for VS Code and Cursor",
  "version": "0.8.0",
  "publisher": "Timorfiy",
  "author": "Timorfiy",
  "engines": {
    "vscode": "^1.104.0"
  },
  "bugs": {
    "url": "https://github.com/Timorfiy/sftp-ftp-sync-ai-conflict-resolution/issues"
  },
  "homepage": "https://github.com/Timorfiy/sftp-ftp-sync-ai-conflict-resolution#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Timorfiy/sftp-ftp-sync-ai-conflict-resolution.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "ftp",
    "sftp",
    "sync",
    "remote"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "sftpSyncAI.conflicts",
        "label": "SFTP/FTP Sync Conflict Resolution"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sftp",
          "title": "SFTP/FTP",
          "icon": "resources/remote-explorer.svg"
        }
      ]
    },
    "views": {
      "sftp": [
        {
          "id": "remoteExplorer",
          "name": "Explorer"
        },
        {
          "id": "transferQueue",
          "name": "Transfer Queue"
        },
        {
          "id": "remoteBackups",
          "name": "Backups"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "remoteExplorer",
        "contents": "No SFTP/FTP configuration found in this workspace.\n[Create Config](command:sftpSyncAI.config)\n[Test Connection](command:sftpSyncAI.testConnection)",
        "when": "!sftpSyncAI.hasConfig"
      },
      {
        "view": "transferQueue",
        "contents": "No transfers in progress.\nStart a sync, upload, or download to see transfers here.",
        "when": "sftpSyncAI.enabled"
      },
      {
        "view": "transferQueue",
        "contents": "Open a workspace folder and create an SFTP/FTP config to get started.",
        "when": "!sftpSyncAI.enabled"
      },
      {
        "view": "remoteBackups",
        "contents": "Select a file in Remote Explorer to view its backups.",
        "when": "sftpSyncAI.enabled"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "SFTP/FTP Sync + AI Conflict Resolution",
      "properties": {
        "sftp.printDebugLog": {
          "type": "boolean",
          "default": false,
          "description": "Print protocol debug output in the SFTP channel. Reload the editor after changing this setting."
        },
        "sftp.debug": {
          "type": "boolean",
          "default": false,
          "description": "Print protocol debug output in the SFTP channel. Reload the editor after changing this setting."
        },
        "sftp.downloadWhenOpenInRemoteExplorer": {
          "type": "boolean",
          "default": false,
          "description": "Download a remote file for local editing instead of opening read-only remote content."
        },
        "sftp.suppressPlaintextPasswordWarning": {
          "type": "boolean",
          "default": false,
          "description": "Suppress the local plaintext-credential warning. This does not encrypt the configuration or plain FTP traffic."
        }
      }
    },
    "commands": [
      {
        "command": "sftpSyncAI.config",
        "title": "Config",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.applyIgnorePreset",
        "title": "Apply Ignore Template",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.testConnection",
        "title": "Test Connection",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.setProfile",
        "title": "Set Profile",
        "category": "SFTP"
      },
      {
