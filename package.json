        "title": "Force Upload",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.upload.file.to.allProfiles",
        "title": "Upload File To All Profiles",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.upload.activeFile.to.allProfiles",
        "title": "Upload Active File To All Profiles",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.upload.folder.to.allProfiles",
        "title": "Upload Folder To All Profiles",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.upload.activeFolder.to.allProfiles",
        "title": "Upload Active Folder To All Profiles",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.upload.project.to.allProfiles",
        "title": "Upload Project To All Profiles",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.forceUpload.to.allProfiles",
        "title": "Force Upload To All Profiles",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.download.file",
        "title": "Download File",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.download.activeFile",
        "title": "Download Active File",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.download.folder",
        "title": "Download Folder",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.download.activeFolder",
        "title": "Download Active Folder",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.download.project",
        "title": "Download Project",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.forceDownload",
        "title": "Force Download",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.sync.localToRemote",
        "title": "Sync Local → Remote",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.sync.remoteToLocal",
        "title": "Sync Remote → Local",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.sync.bothDirections",
        "title": "Sync Both Directions",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.diff",
