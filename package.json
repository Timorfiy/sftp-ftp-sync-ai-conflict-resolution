      },
      {
        "command": "sftpSyncAI.diff.activeFile",
        "title": "Diff Active File with Remote",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.list",
        "title": "List",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.listActiveFolder",
        "title": "List Active Folder",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.listAll",
        "title": "List All",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.delete.remote",
        "title": "Delete Remote",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.rename.remote",
        "title": "Rename Remote",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.create.folder",
        "title": "Create Folder",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.create.file",
        "title": "Create File",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.deleteSavedPassword",
        "title": "Delete Saved Password",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.transferQueue.cancel",
        "title": "Cancel Transfer",
        "category": "SFTP",
        "icon": {
          "light": "resources/light/close.svg",
          "dark": "resources/dark/close.svg"
        }
      },
      {
        "command": "sftpSyncAI.transferQueue.clear",
        "title": "Clear Completed",
        "category": "SFTP",
        "icon": {
          "light": "resources/light/clear-all.svg",
          "dark": "resources/dark/clear-all.svg"
        }
      },
      {
        "command": "sftpSyncAI.openTroubleshooting",
        "title": "Open Troubleshooting",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.remoteBackups.refresh",
        "title": "Refresh Backups",
        "category": "SFTP",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "sftpSyncAI.remoteBackups.open",
        "title": "Open Backup",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.remoteBackups.restore",
        "title": "Restore Backup",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.remoteBackups.delete",
        "title": "Delete Backup",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.revealInRemoteExplorer",
        "title": "Reveal in Remote Explorer",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.remoteExplorer.editInLocal",
        "title": "Edit in Local",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.viewContent",
        "title": "View Content",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.remoteExplorer.refresh",
        "title": "Refresh",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "sftpSyncAI.remoteExplorer.filter",
        "title": "Filter Remote Explorer",
        "icon": "$(filter)"
      },
      {
        "command": "sftpSyncAI.remoteExplorer.clearFilter",
        "title": "Clear Remote Explorer Filter",
        "icon": "$(close)"
      },
      {
        "command": "sftpSyncAI.selectNetworkInterface",
        "title": "Select Network Interface",
        "category": "SFTP"
      },
      {
        "command": "sftpSyncAI.clearConflictState",
        "title": "Clear Conflict State",
        "category": "SFTP/FTP Sync + AI Conflict Resolution"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sftpSyncAI.applyIgnorePreset",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.testConnection"
        },
        {
          "command": "sftpSyncAI.setProfile",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.openConnectInTerminal",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.cancelAllTransfer",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.clearConflictState",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.upload.activeFile",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.upload.activeFolder",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.upload.project",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.upload.activeFile.to.allProfiles",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.upload.activeFolder.to.allProfiles",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.upload.project.to.allProfiles",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.download.activeFile",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.download.activeFolder",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.download.project",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.sync.localToRemote",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.sync.remoteToLocal",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.sync.bothDirections",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.diff.activeFile",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.list",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.listActiveFolder",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.listAll",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.upload.file",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.upload.changedFiles",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.upload.folder",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.forceUpload",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.upload.file.to.allProfiles",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.upload.folder.to.allProfiles",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.forceUpload.to.allProfiles",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.download.file",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.download.folder",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.forceDownload",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.diff",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.delete.remote",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.rename.remote",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.create.folder",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.create.file",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.deleteSavedPassword",
