        },
        {
          "command": "sftpSyncAI.remoteBackups.refresh",
          "when": "sftpSyncAI.enabled"
        },
        {
          "command": "sftpSyncAI.remoteBackups.open",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.remoteBackups.restore",
          "when": "false"
        },
        {
          "command": "sftpSyncAI.remoteBackups.delete",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "sftpSyncAI.revealInRemoteExplorer",
          "group": "navigation@20",
          "when": "sftpSyncAI.enabled && !explorerResourceIsRoot"
        },
        {
          "command": "sftpSyncAI.diff",
          "group": "3_compare",
          "when": "sftpSyncAI.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftpSyncAI.sync.localToRemote",
          "group": "sftp.sync@1",
          "when": "sftpSyncAI.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftpSyncAI.sync.remoteToLocal",
          "group": "sftp.sync@2",
          "when": "sftpSyncAI.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftpSyncAI.sync.bothDirections",
          "group": "sftp.sync@3",
          "when": "sftpSyncAI.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftpSyncAI.upload.file",
          "group": "sftp.trans@1",
          "when": "sftpSyncAI.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftpSyncAI.upload.folder",
          "group": "sftp.trans@1",
          "alt": "sftpSyncAI.forceUpload",
          "when": "sftpSyncAI.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftpSyncAI.upload.file.to.allProfiles",
          "group": "sftp.trans@1",
          "when": "sftpSyncAI.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftpSyncAI.upload.folder.to.allProfiles",
          "group": "sftp.trans@1",
          "alt": "sftpSyncAI.forceUpload.to.allProfiles",
          "when": "sftpSyncAI.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftpSyncAI.download.file",
          "group": "sftp.trans@2",
          "when": "sftpSyncAI.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftpSyncAI.download.folder",
          "group": "sftp.trans@2",
          "alt": "sftpSyncAI.forceDownload",
          "when": "sftpSyncAI.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftpSyncAI.delete.remote",
          "group": "sftp.trans@3",
          "when": "sftpSyncAI.enabled && !explorerResourceIsRoot"
        }
      ],
      "editor/context": [
        {
          "command": "sftpSyncAI.upload.file",
          "group": "sftp.trans@1",
          "when": "sftpSyncAI.enabled && resourceScheme == file"
        },
        {
          "command": "sftpSyncAI.upload.file.to.allProfiles",
          "group": "sftp.trans@1",
          "when": "sftpSyncAI.enabled && resourceScheme == file"
        },
        {
          "command": "sftpSyncAI.download.file",
          "group": "sftp.trans@2",
          "when": "sftpSyncAI.enabled && resourceScheme == file"
        },
        {
          "command": "sftpSyncAI.diff",
          "group": "3_compare",
          "when": "sftpSyncAI.enabled && resourceScheme == file"
        },
        {
          "command": "sftpSyncAI.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "sftpSyncAI.enabled && resourceScheme == remote"
        }
      ],
      "editor/title/context": [
        {
          "command": "sftpSyncAI.revealInExplorer",
          "group": "2_files",
          "when": "sftpSyncAI.enabled && resourceScheme == remote"
        },
        {
          "command": "sftpSyncAI.revealInRemoteExplorer",
          "when": "sftpSyncAI.enabled && resourceScheme == file",
          "group": "2_files"
        }
      ],
      "view/title": [
        {
          "command": "sftpSyncAI.remoteExplorer.refresh",
          "when": "view == remoteExplorer",
          "group": "navigation"
        },
        {
          "command": "sftpSyncAI.remoteExplorer.filter",
          "when": "view == remoteExplorer && !sftpSyncAI.hasRemoteFilter",
          "group": "navigation"
        },
        {
          "command": "sftpSyncAI.remoteExplorer.clearFilter",
          "when": "view == remoteExplorer && sftpSyncAI.hasRemoteFilter",
          "group": "navigation"
        },
        {
          "command": "sftpSyncAI.transferQueue.clear",
          "when": "view == transferQueue",
          "group": "navigation"
        },
        {
          "command": "sftpSyncAI.remoteBackups.refresh",
          "when": "view == remoteBackups",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sftpSyncAI.testConnection",
          "group": "navigation@1",
          "when": "view == remoteExplorer && viewItem == root"
        },
        {
          "command": "sftpSyncAI.transferQueue.cancel",
          "group": "inline",
          "when": "view == transferQueue && viewItem == activeTransfer"
        },
        {
          "command": "sftpSyncAI.openConnectInTerminal",
          "group": "navigation",
          "when": "view == remoteExplorer && viewItem == root"
        },
        {
          "command": "sftpSyncAI.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem == file && !config.sftp.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "sftpSyncAI.viewContent",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem == file && config.sftp.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "sftpSyncAI.revealInExplorer",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem != root"
        },
        {
          "command": "sftpSyncAI.upload.folder",
          "group": "3_trans@1",
          "alt": "sftpSyncAI.forceUpload",
          "when": "sftpSyncAI.enabled && viewItem != file"
        },
        {
          "command": "sftpSyncAI.upload.file",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "sftpSyncAI.upload.folder.to.allProfiles",
          "group": "3_trans@1",
          "alt": "sftpSyncAI.forceUpload.to.allProfiles",
          "when": "sftpSyncAI.enabled && viewItem != file"
        },
        {
          "command": "sftpSyncAI.upload.file.to.allProfiles",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "sftpSyncAI.download.folder",
          "group": "3_trans@2",
          "alt": "sftpSyncAI.forceDownload",
          "when": "sftpSyncAI.enabled && viewItem != file"
        },
        {
          "command": "sftpSyncAI.download.file",
          "group": "3_trans@2",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "sftpSyncAI.rename.remote",
          "group": "7_modification@1",
          "when": "view == remoteExplorer && viewItem != root"
        },
        {
          "command": "sftpSyncAI.delete.remote",
          "group": "7_modification@2",
          "when": "view == remoteExplorer && viewItem != root"
        },
        {
          "command": "sftpSyncAI.create.folder",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != file"
        },
        {
          "command": "sftpSyncAI.create.file",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != file"
        },
        {
          "command": "sftpSyncAI.remoteBackups.open",
          "group": "1_open@1",
          "when": "view == remoteBackups && viewItem == backupVersion"
        },
        {
          "command": "sftpSyncAI.remoteBackups.restore",
          "group": "2_actions@1",
          "when": "view == remoteBackups && viewItem == backupVersion"
        },
        {
          "command": "sftpSyncAI.remoteBackups.delete",
          "group": "7_modification@1",
          "when": "view == remoteBackups && viewItem == backupVersion"
        }
      ],
      "scm/title": [
        {
          "command": "sftpSyncAI.upload.changedFiles",
          "group": "sftp",
          "when": "sftpSyncAI.enabled && scmProvider == git && !gitFreshRepository"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "sftpSyncAI.upload.changedFiles",
          "group": "inline",
          "when": "sftpSyncAI.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "sftpSyncAI.upload.changedFiles",
          "group": "sftp",
          "when": "sftpSyncAI.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "sftpSyncAI.upload.changedFiles",
          "group": "inline",
          "when": "sftpSyncAI.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        },
        {
          "command": "sftpSyncAI.upload.changedFiles",
          "group": "sftp",
          "when": "sftpSyncAI.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sftpSyncAI.upload.changedFiles",
        "key": "ctrl+alt+u",
        "when": "sftpSyncAI.enabled"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/sftp.json",
        "url": "./schema/config.schema.json"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "remote",
        "formatting": {
          "label": "${path}",
          "separator": "/"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "npm run compile && jest",
    "test:acceptance:ftp": "jest --runInBand --detectOpenHandles test/acceptance/ftp.acceptance.spec.js",
    "test:acceptance:sftp": "jest --runInBand --detectOpenHandles test/acceptance/sftp.acceptance.spec.js",
    "package": "node scripts/release.js package",
    "package:inspect": "node scripts/release.js inspect",
    "package:list": "vsce ls --tree",
    "release:dry-run": "node scripts/release.js dry-run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.0",
    "@types/vscode": "1.104.0",
    "@vscode/vsce": "4.0.0",
    "braces": ">=2.3.1",
    "eslint": "^10.4.1",
    "glob-parent": ">=5.1.2",
    "jest": "^30.4.2",
    "json-schema": ">=0.4.0",
    "memfs": "^4.57.7",
    "merge": ">=2.1.1",
    "ovsx": "1.2.0",
    "set-value": "^4.0.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^7.0.3",
    "yargs-parser": "^22.0.0",
    "yauzl": "3.4.0",
    "yazl": "^2.5.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "basic-ftp": "6.0.1",
    "fs-extra": "^11.2.0",
    "ignore": "^7.0.0",
    "jsonc-parser": "3.3.1",
    "lodash.debounce": "^4.0.8",
    "lru-cache": "^11.5.0",
    "ssh-config": "^5.1.0",
    "ssh2": "^1.15.0",
    "tmp": "^0.2.3",
    "upath": "^3.0.7",
    "zod": "^4.4.0"
  },
  "jest": {
    "verbose": true,
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": "<rootDir>/test/preprocessor.js"
    },
    "testMatch": [
      "**/test/**/*.spec.js",
      "**/__tests__/*.ts"
    ]
  }
}
